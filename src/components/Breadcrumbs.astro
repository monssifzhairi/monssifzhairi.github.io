---
import type { Crumb } from '../lib/schema';

type Props = {
  crumbs: Crumb[];
};

/**
 * Visible breadcrumb trail. Mirrors the BreadcrumbList JSON-LD node exactly
 * (names and URLs), per blueprint §10 and §14. Never rendered on the homepage.
 */
const { crumbs } = Astro.props;
---

<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {
      crumbs.map((c, i) => {
        const last = i === crumbs.length - 1;
        return (
          <li>
            {last ? (
              <span aria-current="page">{c.name}</span>
            ) : (
              <a href={c.href}>{c.name}</a>
            )}
            {!last && (
              <span class="crumbs__sep" aria-hidden="true">
                /
              </span>
            )}
          </li>
        );
      })
    }
  </ol>
</nav>

<style>
  .crumbs ol {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem;
    list-style: none;
  }

  .crumbs li {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-family: var(--font-display);
    font-size: 0.74rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .crumbs a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    color: var(--label);
    transition: color var(--t-base) ease;
  }

  .crumbs a:hover,
  .crumbs a:focus-visible {
    color: var(--accent);
  }

  .crumbs [aria-current='page'] {
    color: var(--accent);
  }

  .crumbs__sep {
    color: var(--line-strong);
  }
</style>