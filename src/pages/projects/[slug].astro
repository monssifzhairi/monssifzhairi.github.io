---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHead from '../../components/SectionHead.astro';
import { projectMeta } from '../../data/meta';
import { PROJECTS, getProjectNeighbours, type Project } from '../../data/projects';
import { projectPath, type Crumb } from '../../lib/schema';
import { SITE } from '../../data/site';

/**
 * Project case studies.
 *
 * Every project page is generated from src/data/projects.ts, so all repository
 * and demo URLs stay centralised in that one file. The section order is
 * identical on every project page (blueprint §6).
 */
export function getStaticPaths() {
  return PROJECTS.map((project) => ({
    params: { slug: project.slug },
    props: { project },
  }));
}

const { project } = Astro.props as { project: Project };

const crumbs: Crumb[] = [
  { name: 'Home', href: '/' },
  { name: 'Projects', href: '/projects/' },
  { name: project.name, href: projectPath(project.slug) },
];

const { previous, next } = getProjectNeighbours(project.slug);

// Non-empty only when a real repository and real stack entries exist.
const hasProjectNode = Boolean(project.repo) || project.stack.length > 0;
const stackKnown = project.stack.length > 0;
const featuresKnown = project.features.length > 0;
const howKnown = project.how.length > 0;
---

<BaseLayout
  meta={projectMeta(project)}
  graph={{
    withWebsite: true,
    crumbs,
    project: hasProjectNode
      ? {
          name: project.name,
          description: project.summary,
          href: projectPath(project.slug),
          repo: project.repo,
          stack: project.stack,
        }
      : undefined,
  }}
>
  <div class="container">
    <div class="page-top">
      <Breadcrumbs crumbs={crumbs} />
      <p class="micro" aria-hidden="true">{project.index}</p>
      <h1 class="page-title" data-reveal>{project.name}</h1>
      <p class="page-lede measure-narrow" data-reveal>{project.summary}</p>

      <ul class="tags page-tags" aria-label={`${project.name} tech stack`} data-reveal>
        {
          stackKnown ? (
            project.stack.map((t) => <li>{t}</li>)
          ) : (
            <li>Stack to confirm</li>
          )
        }
      </ul>

      {
        project.disclaimer && (
          <p class="disclaimer" role="note" data-reveal>
            {project.disclaimer}
          </p>
        )
      }
    </div>
  </div>

  <!-- Typographic hero figure.
       Deliberately typographic, not a fabricated screenshot. When a real
       project image exists it can be added here as a real <img> with
       explicit width/height and alt text; nothing else about the page or its
       structured data needs to change. -->
  <section class="section hero-figure" aria-labelledby="figure-title">
    <h2 class="sr-only" id="figure-title">Project mark</h2>
    <div class="container">
      <div class="hero-figure__frame" aria-hidden="true">
        <span class="hero-figure__text">{project.heroFigure}</span>
      </div>
    </div>
  </section>

  <!-- 1. Overview -->
  <section class="section rule" aria-labelledby="overview">
    <div class="container">
      <SectionHead marker="// 01" title="Overview" id="overview" />
      <div class="prose measure-narrow" data-reveal>
        {project.overview.map((p) => <p>{p}</p>)}
      </div>
    </div>
  </section>

  <!-- 2. What it does / what I built -->
  <section class="section rule" aria-labelledby="features">
    <div class="container">
      <SectionHead marker="// 02" title="What it does" id="features" />
      {
        featuresKnown ? (
          <ul class="feature-list" data-reveal>
            {project.features.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        ) : (
          <div class="todo-block" data-reveal>
            <p class="micro">To confirm</p>
            <p>
              The individual features of this project have not been confirmed yet. Nothing
              is listed here rather than guessed.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- 3. How it's built -->
  <section class="section rule" aria-labelledby="how">
    <div class="container">
      <SectionHead marker="// 03" title="How it's built" id="how" />
      {
        howKnown ? (
          <div class="prose measure-narrow" data-reveal>
            {project.how.map((p) => (
              <p>{p}</p>
            ))}
          </div>
        ) : (
          <div class="todo-block" data-reveal>
            <p class="micro">To confirm</p>
            <p>
              The stack and technical decisions for this project have not been confirmed
              yet.
            </p>
          </div>
        )
      }
    </div>
  </section>

  <!-- 4. Status -->
  <section class="section rule" aria-labelledby="status">
    <div class="container">
      <SectionHead marker="// 04" title="Status" id="status" />
      <div data-reveal>
        {
          project.status ? (
            <p class="status-line">
              <span class="status-line__dot" aria-hidden="true"></span>
              <span class="status-line__value">{project.status}</span>
            </p>
          ) : (
            <div class="todo-block">
              <p class="micro">To confirm</p>
              <p>The status of this project has not been confirmed yet.</p>
            </div>
          )
        }
      </div>
    </div>
  </section>

  <!-- 5. Links. Only real URLs; nothing is linked if it does not exist. -->
  <section class="section rule" aria-labelledby="links">
    <div class="container">
      <SectionHead marker="// 05" title="Links" id="links" />
      <div class="links" data-reveal>
        {
          project.repo ? (
            <a
              class="btn"
              href={project.repo}
              target="_blank"
              rel="noopener noreferrer"
            >
              Repository<span class="sr-only"> — opens in a new tab</span>
            </a>
          ) : (
            <span class="todo">No public repository</span>
          )
        }
        {
          project.demo ? (
            <a
              class="btn"
              href={project.demo}
              target="_blank"
              rel="noopener noreferrer"
            >
              Live demo<span class="sr-only"> — opens in a new tab</span>
            </a>
          ) : (
            <span class="todo">No live demo</span>
          )
        }
      </div>
    </div>
  </section>

  <!-- 6. Footer navigation -->
  <nav class="section rule project-nav" aria-label="Project navigation">
    <div class="container">
      <div class="project-nav__grid">
        {
          previous && (
            <a class="project-nav__link" href={projectPath(previous.slug)} rel="prev">
              <span class="micro micro--tight">Previous</span>
              <span class="project-nav__name">{previous.name}</span>
            </a>
          )
        }
        <a class="project-nav__all" href="/projects/">
          <span class="micro micro--tight">Index</span>
          <span class="project-nav__name">All projects</span>
        </a>
        {
          next && (
            <a
              class="project-nav__link project-nav__link--next"
              href={projectPath(next.slug)}
              rel="next"
            >
              <span class="micro micro--tight">Next</span>
              <span class="project-nav__name">{next.name}</span>
            </a>
          )
        }
      </div>

      <p class="project-nav__author">
        Built by <a class="link" href="/about/">{SITE.name}</a>.
      </p>
    </div>
  </nav>
</BaseLayout>

<style>
  .page-top {
    padding-top: clamp(2.5rem, 8vw, 5rem);
  }

  .page-title {
    margin-top: 0.85rem;
    font-size: clamp(2.5rem, 9vw, 7rem);
    color: var(--accent);
  }

  .page-lede {
    margin-top: 1.5rem;
    font-size: clamp(1.05rem, 2.4vw, 1.35rem);
    font-weight: 300;
    line-height: 1.6;
    color: var(--text-soft);
  }

  .page-tags {
    margin-top: 1.75rem;
  }

  .disclaimer {
    margin-top: 2rem;
    max-width: 62ch;
    padding: 1rem 1.15rem;
    border-left: 2px solid var(--line-strong);
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--text-muted);
  }

  /* Typographic hero. Real design content — not an image, and not a
     representation of a screenshot. */
  .hero-figure {
    padding-block: clamp(2rem, 6vw, 4rem);
  }

  .hero-figure__frame {
    position: relative;
    display: grid;
    place-items: center;
    min-height: clamp(16rem, 42vw, 30rem);
    border: 1px solid var(--line);
    background:
      radial-gradient(
        120% 120% at 50% 0%,
        rgba(255, 255, 255, 0.045) 0%,
        transparent 60%
      ),
      var(--surface);
    overflow: hidden;
  }

  .hero-figure__text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(3.5rem, 17vw, 13rem);
    line-height: 0.9;
    letter-spacing: -0.02em;
    color: var(--line-strong);
    text-align: center;
    padding-inline: 1rem;
    user-select: none;
  }

  @supports (-webkit-text-stroke: 1px #fff) {
    .hero-figure__text {
      color: transparent;
      -webkit-text-stroke: 1px var(--line-strong);
    }
  }

  .feature-list {
    list-style: none;
    border-top: 1px solid var(--line);
    max-width: 44rem;
  }

  .feature-list li {
    position: relative;
    padding: 1.05rem 0 1.05rem 2rem;
    border-bottom: 1px solid var(--line);
    font-size: 1.02rem;
    color: var(--text);
  }

  .feature-list li::before {
    content: '//';
    position: absolute;
    left: 0;
    font-family: var(--font-display);
    font-size: 0.8rem;
    letter-spacing: 0.1em;
    color: var(--label);
  }

  .status-line {
    display: inline-flex;
    align-items: center;
    gap: 0.85rem;
    padding: 1rem 1.5rem;
    border: 1px solid var(--line);
  }

  .status-line__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
  }

  .status-line__value {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 0.95rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--text);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.85rem;
  }

  .project-nav {
    padding-block: clamp(3rem, 7vw, 5rem);
  }

  .project-nav__grid {
    display: grid;
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    grid-template-columns: 1fr;
  }

  @media (min-width: 48rem) {
    .project-nav__grid {
      grid-template-columns: 1fr auto 1fr;
    }
  }

  .project-nav__link,
  .project-nav__all {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    min-height: 44px;
    padding: 1.35rem 1.5rem;
    background: var(--bg);
    transition: background-color var(--t-base) ease;
  }

  .project-nav__link:hover,
  .project-nav__link:focus-visible,
  .project-nav__all:hover,
  .project-nav__all:focus-visible {
    background: var(--surface-2);
  }

  .project-nav__link--next {
    text-align: right;
  }

  .project-nav__name {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 2.4vw, 1.6rem);
    text-transform: uppercase;
    letter-spacing: 0.02em;
    color: var(--text);
  }

  .project-nav__author {
    margin-top: 2rem;
    font-size: 0.95rem;
    color: var(--text-muted);
  }
</style>